      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit event"
          }
        }
      }
    },
    "V tomto účtu kalendář vytvořit nejde. Vyberte iCloud, Exchange nebo kalendáře v zařízení.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calendar cannot be created in this account. Choose iCloud, Exchange or the calendars on this device."
          }
        }
      }
    },
    "V ukázkovém režimu nejsou události v systémovém kalendáři, takže se editor pozvánek neotevře.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In demo mode the events are not in the system calendar, so the invitation editor does not open."
          }
        }
      }
    },
    "V zapnutých kalendářích a kategoriích žádná událost neobsahuje „%@“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No event in the switched-on calendars and categories contains “%@”."
          }
        }
      }
    },
    "V zařízení není účet, ve kterém by šel kalendář vytvořit. Přidejte iCloud nebo Exchange v Nastavení.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no account on this device that can hold a new calendar. Add iCloud or Exchange in Settings."
          }
        }
      }
    },
    "V čase začátku": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
