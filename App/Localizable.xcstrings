          "stringUnit": {
            "state": "translated",
            "value": "Choose a symbol for the category."
          }
        }
      }
    },
    "Vyberte účet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an account."
          }
        }
      }
    },
    "Vybraný kalendář už neexistuje. Vyberte jiný.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen calendar no longer exists. Choose another."
