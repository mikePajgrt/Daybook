    "Vytvořit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create"
          }
        }
      }
    },
    "Všechno, co máte v plánu, na jedné obrazovce": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you have planned, on one screen"
          }
        }
      }
    },
    "Všechny kalendáře v zařízení jsou jen pro čtení. Založte si kalendář volbou Nový kalendář, nebo přidejte účet v Nastavení.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every calendar on this device is read-only. Create one with New calendar, or add an account in Settings."
          }
        }
      }
    },
    "Zadejte název kalendáře.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name for the calendar."
          }
        }
      }
    },
    "Zadejte název kategorie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name for the category."
          }
        }
      }
    },
    "Zahodit změny": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard changes"
          }
        }
      }
    },
    "Zahodit změny?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard changes?"
          }
        }
      }
    },
    "Zahrne i kalendáře a kategorie, které máte vypnuté.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also includes the calendars and categories you have switched off."
          }
        }
      }
    },
    "Zatím nemáte žádné kategorie. Kategorie jsou vaše vlastní štítky, například Porady nebo Sport.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have no categories yet. Categories are your own labels, such as Meetings or Sport."
          }
        }
      }
    },
    "Začátek": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        }
      }
    },
    "Zelená": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green"
          }
        }
      }
    },
    "Změnit barvu…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change colour…"
          }
        }
      }
