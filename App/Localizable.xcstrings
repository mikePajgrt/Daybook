    "Kalendář %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar %@"
          }
        }
      }
    },
    "Kalendář je jen pro čtení, změny v něm uložit nejde.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar is read-only, so changes cannot be saved to it."
          }
        }
      }
    },
    "Kalendář pro účet Google založte na webu Googlu a zapněte ho pro synchronizaci. Pak se tu objeví sám.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a calendar for a Google account on Google's website and turn on syncing for it. It will then appear here by itself."
          }
        }
      }
    },
    "Kalendář se nepodařilo vytvořit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar could not be created"
          }
        }
      }
    },
    "Kalendář „%@“ je jen pro čtení. Událost tu nejde upravit ani smazat, kategorie ano.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar “%@” is read-only. The event cannot be edited or deleted here, but its categories can."
          }
        }
      }
    },
    "Kalendáře a kategorie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendars and categories"
          }
        }
      }
    },
    "Kategorie": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories"
          }
        }
      }
    },
    "Kategorie celé série": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories of the whole series"
          }
        }
      }
    },
    "Kategorie je přiřazená k %lld událostem a sériím. Odebere se z nich, události samotné zůstanou v kalendáři.": {
      "localizations": {
        "cs": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kategorie je přiřazená k %lld událostem a sériím. Odebere se z nich, události samotné zůstanou v kalendáři."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kategorie je přiřazená k %lld událostem a sériím. Odebere se z nich, události samotné zůstanou v kalendáři."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kategorie je přiřazená k 1 události nebo sérii. Odebere se z ní, událost samotná zůstane v kalendáři."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kategorie je přiřazená k %lld událostem a sériím. Odebere se z nich, události samotné zůstanou v kalendáři."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The category is on 1 event or series. It will be removed from it; the event itself stays in the calendar."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The category is on %lld events and series. It will be removed from them; the events themselves stay in the calendar."
                }
              }
            }
          }
        }
      }
    },
    "Kategorie jen této události": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories of this event only"
          }
        }
      }
    },
    "Kategorie jsou jen vaše: do události se nezapisují a ostatní účastníci je neuvidí.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories are yours alone: they are not written into the event and other attendees do not see them."
          }
        }
      }
    },
    "Kategorie platí pro všechny výskyty této opakované události.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories apply to every occurrence of this repeating event."
          }
        }
      }
    },
    "Kategorie s tímto názvem už existuje. Zvolte jiný název.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A category with this name already exists. Choose another name."
          }
        }
      }
    },
    "Kategorie se nedaří uložit. Změny vydrží jen do zavření aplikace.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories cannot be saved. Changes last only until the app is closed."
          }
        }
      }
    },
    "Kategorie se nepodařilo změnit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The categories could not be changed"
          }
        }
      }
    },
    "Kategorie se nepřenesly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The categories were not carried over"
          }
        }
      }
    },
    "Kategorie se přidají jen k této události. Kategorie celé série tu zůstávají.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories are added to this event only. The whole series' categories stay."
          }
        }
      }
    },
    "Kategorie se rozlišují symbolem, ne barvou. Barvu mají kalendáře.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories are told apart by symbol, not colour. Colour belongs to calendars."
          }
        }
      }
    },
    "Kategorie se synchronizují přes iCloud mezi vašimi zařízeními.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories sync between your devices through iCloud."
          }
        }
      }
    },
    "Kategorie se teď neukládají": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories are not being saved"
          }
        }
      }
    },
    "Kategorie se ukládají jen v tomto zařízení.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories are stored on this device only."
          }
        }
      }
    },
    "Kategorie už neexistuje. Nejspíš ji mezitím smazalo jiné zařízení.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category no longer exists. Another device probably deleted it."
          }
        }
      }
    },
    "Kategorie vidíte jen vy. Do událostí se nezapisují, ostatní účastníci ani jiné aplikace je neuvidí.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you see categories. They are not written into events, and neither other attendees nor other apps see them."
          }
        }
      }
    },
    "Kategorie založíte v postranním panelu volbou Nová kategorie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create categories in the sidebar with New category."
          }
        }
      }
    },
    "Kategorie založíte v seznamu Kalendáře a kategorie volbou Nová kategorie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create categories in the Calendars and categories list with New category."
          }
        }
      }
    },
    "Kategorie zatím není u žádné události. Události samotné zůstanou v kalendáři.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No event has this category yet. The events themselves stay in the calendar."
          }
        }
      }
    },
    "Kategorie: zatím žádné": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Categories: none yet"
          }
        }
      }
    },
    "Kategorii se nepodařilo vytvořit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category could not be created"
          }
        }
      }
    },
    "Kategorii se nepodařilo změnit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The category could not be changed"
          }
        }
      }
    },
    "Každých %lld dní": {
      "localizations": {
        "cs": {
          "variations": {
            "plural": {
