          "stringUnit": {
            "state": "translated",
            "value": "all day"
          }
        }
      }
    },
    "iCloud teď není dostupný. Kategorie se ukládají v tomto zařízení a synchronizují se, až bude.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is not available right now. Categories are stored on this device and will sync when it is."
          }
        }
      }
    },
