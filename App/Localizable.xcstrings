    "URL": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "URL"
          }
        }
      }
    },
    "Událost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event"
          }
        }
      }
    },
    "Událost není kam uložit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nowhere to save the event"
          }
        }
      }
    },
    "Událost se nejdřív uloží, pak se otevře systémový editor, ve kterém pozvete lidi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event is saved first, then the system editor opens, where you invite people."
          }
        }
      }
    },
    "Událost se nepodařilo smazat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event could not be deleted"
          }
        }
      }
    },
    "Událost se nepodařilo uložit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event could not be saved"
          }
        }
      }
    },
    "Událost se opakuje. Vyberte, které výskyty smazat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event repeats. Choose which occurrences to delete."
          }
        }
      }
    },
    "Událost se opakuje. Vyberte, kterých výskytů se změny týkají.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event repeats. Choose which occurrences the changes apply to."
          }
        }
      }
    },
    "Událost se uložila, ale kategorie ne. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event was saved, but its categories were not. %@"
          }
        }
      }
    },
    "Událost se uložila, ale nová část opakování nemá kategorie původní série. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event was saved, but the new part of the repeat does not have the original series' categories. %@"
          }
        }
      }
    },
    "Událost se v systémovém kalendáři nepodařilo najít. Pozvěte účastníky v aplikaci Kalendář nebo zkuste událost otevřít znovu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event could not be found in the system calendar. Invite people in the Calendar app or try opening the event again."
          }
        }
      }
    },
    "Událost už v kalendáři není, nejspíš ji mezitím někdo smazal nebo přesunul. Úpravy zůstávají ve formuláři: zkopírujte si, co potřebujete, zrušte úpravy a událost vyhledejte nebo vytvořte znovu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event is no longer in the calendar; someone probably deleted or moved it meanwhile. Your changes stay in the form: copy what you need, cancel the changes, then find the event or create it again."
          }
        }
      }
    },
    "Událost už v kalendáři není. Mezitím ji nejspíš někdo smazal nebo přesunul.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event is no longer in the calendar. Someone probably deleted or moved it meanwhile."
          }
        }
      }
    },
    "Událost zmizí ze všech zařízení, která tento kalendář používají.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event disappears from every device that uses this calendar."
          }
        }
      }
    },
    "Ukládání": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage"
          }
        }
